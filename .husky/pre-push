# Runs the full e2e suite against a fresh local Supabase before every push,
# mirroring .github/workflows/e2e.yml -- catches a broken suite locally
# instead of red CI. Needs Docker running + the Supabase CLI on PATH (same
# prerequisites as `npm run test:e2e:local`); skip once with
# `git push --no-verify` if you know what you're doing.
#
# scripts/e2e-local.sh exits 75 specifically when it fails to even get a
# local Supabase up (no Docker, blocked image pulls, missing CLI, etc.) --
# as opposed to a real Cypress test failure, which exits some other way and
# must still hard-fail the push. Only that specific code falls back to
# `npm run preflight` (typecheck only, no Docker/network needed) -- weaker
# than the full e2e run and not a replacement for it, just enough to avoid
# unconditionally blocking a push from an environment that structurally
# cannot run Docker (e.g. a sandboxed CI/agent session with an egress
# policy blocking image pulls).
echo "Running e2e suite before push (this starts a local Supabase and takes a few minutes)..."
npm run test:e2e:local
status=$?

if [ "$status" -eq 0 ]; then
  exit 0
fi

if [ "$status" -eq 75 ]; then
  echo "Couldn't get a local Supabase up in this environment -- falling back to 'npm run preflight' (typecheck only)." >&2
  npm run preflight
  exit $?
fi

exit "$status"

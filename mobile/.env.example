# Same Supabase project as the web app -- these are public
# (publishable/anon) values, safe to commit as an example.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Crash and error reporting (plugins/00.sentry.client.ts), Sentry project
# quiroflow-app. Public too: a DSN can only send events. Leave it blank for a
# local build against a local backend, or its errors land with production's.
NUXT_PUBLIC_SENTRY_DSN=

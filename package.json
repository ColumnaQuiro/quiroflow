{
  "name": "quiroflow",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "./scripts/with-node.sh nuxt build",
    "dev": "./scripts/with-node.sh nuxt dev",
    "generate": "./scripts/with-node.sh nuxt generate",
    "preview": "./scripts/with-node.sh nuxt preview",
    "check:migrations": "./scripts/with-node.sh node scripts/check-migration-versions.mjs",
    "check:migration-compatibility": "./scripts/with-node.sh node scripts/check-migration-compatibility.mjs",
    "check:migrations-applied": "./scripts/with-node.sh node scripts/check-migrations-applied.mjs",
    "check:crons-scheduled": "./scripts/with-node.sh node scripts/check-crons-scheduled.mjs",
    "check:e2e-shards": "./scripts/with-node.sh node scripts/check-e2e-shards.mjs",
    "check:theme-tokens": "./scripts/with-node.sh node scripts/check-theme-tokens.mjs",
    "check:rls-initplan": "./scripts/with-node.sh node scripts/check-rls-initplan.mjs",
    "check:rls-two-factor": "./scripts/with-node.sh node scripts/check-rls-two-factor.mjs",
    "preflight": "npm run check:migrations && npm run check:migration-compatibility && npm run check:e2e-shards && npm run check:theme-tokens && npm run check:rls-initplan && npm run check:rls-two-factor && npm run test:unit && ./scripts/with-node.sh nuxi typecheck",
    "postinstall": "./scripts/with-node.sh nuxt prepare",
    "test:e2e": "start-server-and-test dev http://localhost:3000 'cypress run'",
    "test:e2e:local": "./scripts/e2e-local.sh",
    "test:e2e:open": "start-server-and-test dev http://localhost:3000 'cypress open'",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open",
    "supabase:test:reset": "supabase db reset",
    "prepare": "husky",
    "apply:migrations": "./scripts/with-node.sh node scripts/apply-migrations.mjs",
    "test:unit": "./scripts/with-node.sh vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@nuxtjs/supabase": "^2.0.10",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^1.0.2",
    "@stripe/stripe-js": "^9.13.0",
    "@supabase/supabase-js": "^2.112.3",
    "@types/pdfkit": "^0.17.6",
    "chart.js": "^4.5.1",
    "firebase": "^12.18.0",
    "nuxt": "^3.21.11",
    "papaparse": "^5.6.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.15.0",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "stripe": "^22.5.0",
    "vue": "^3.5.41",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.4.5"
  },
  "overrides": {
    "@nuxt/devtools": {
      "vite": "7.3.6"
    }
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "cypress": "^15.21.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "start-server-and-test": "^3.0.12",
    "typescript": "5.7",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.10",
    "ws": "^8.21.3"
  }
}

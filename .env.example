# Supabase (create a project at https://supabase.com/dashboard)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=
# Service role key (Project Settings -> API -> service_role secret). Only
# needed for server routes Meta calls directly with no user session, like
# the WhatsApp delivery/reply webhook -- keep this out of any NUXT_PUBLIC_*
# var, it must never reach the browser.
NUXT_SUPABASE_SECRET_KEY=

# WhatsApp delivery-status + reply webhook (Settings -> WhatsApp has the
# exact URL to register). Any string works -- Meta just echoes it back
# during the one-time verification handshake to prove you own the endpoint.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Resend (create an API key at https://resend.com)
NUXT_RESEND_API_KEY=

# Booking subdomains: <account-slug>.<this domain> -> /book/<account-slug>
# Leave unset to use localtest.me (works locally, no DNS setup). Set to your
# real domain once deployed with wildcard DNS (*.yourdomain.com).
NUXT_PUBLIC_APP_DOMAIN=

# Optional. Auto-registers each new clinic's booking subdomain as a Netlify
# domain alias right after sign-up -- User settings -> Applications -> New
# access token, and the site ID from Site configuration -> General. Leave
# both unset to skip this (the subdomain can always be added manually).
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# Optional. Enables Stripe Connect on Settings -> Payments: clinics click
# "Connect with Stripe" instead of pasting their own API keys, and every
# connected clinic's events land on one shared webhook. Requires enabling
# Connect on your own Stripe account first (Dashboard -> Connect -> Get
# started), Standard accounts. Without these three set, Settings -> Payments
# falls back to the legacy manual-key flow.
#   NUXT_STRIPE_SECRET_KEY: your PLATFORM account's own secret key (sk_...)
#   NUXT_PUBLIC_STRIPE_CONNECT_CLIENT_ID: Dashboard -> Connect -> Settings ->
#     "client_id" (ca_...) -- also register the redirect URI there:
#     <your app URL>/api/stripe/oauth/callback (both prod and any dev URL you use)
#   NUXT_STRIPE_CONNECT_WEBHOOK_SECRET: Dashboard -> Developers -> Webhooks ->
#     add endpoint at <your app URL>/api/stripe/webhook, "Listen to events on
#     Connected accounts", selecting invoice.paid, invoice.payment_failed,
#     subscription_schedule.updated, subscription_schedule.released,
#     subscription_schedule.canceled -- then paste its signing secret here.
NUXT_STRIPE_SECRET_KEY=
NUXT_PUBLIC_STRIPE_CONNECT_CLIENT_ID=
NUXT_STRIPE_CONNECT_WEBHOOK_SECRET=

# Required for the 'patient.birthday' automation trigger. A Postgres
# pg_cron job calls POST /api/automations/birthday-cron once a day via
# pg_net -- that call carries no session, so this shared secret (any
# random string) is checked instead, sent as the X-Cron-Secret header.
# Set the same value in the pg_cron job (see the migration that adds it).
NUXT_CRON_SECRET=
